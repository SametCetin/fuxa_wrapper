  "scripts": [
    {
      "id": "s_opstop_toggle",
      "name": "OpPanelStopToggle",
      "sync": false,
      "parameters": [],
      "mode": "SERVER",
      "code": "// Boolean tag toggle. Tag'i FUXA'daki ADI ile bul (ADS adresi degil).\n// Not: 'Toggle value' aksiyonu FUXA 1.3.4 + ADS'de TRUE->FALSE yazamiyor, bu yuzden script.\nconst id = $getTagId('.OpPanelEStopBtn.IN_Simu', 'tc3_ads');\nconst v = $getTag(id);\nawait $setTag(id, !(v === true || v === 1 || v === '1' || v === 'true'));\n"
    },
    {
      "id": "s_0b26152a-452043eb",
      "name": "SimuHmiToggle",
      "sync": false,
      "parameters": [],
      "mode": "SERVER",
      "code": "// Boolean tag toggle. Tag'i FUXA'daki ADI ile bul (ADS adresi degil).\n// Not: 'Toggle value' aksiyonu FUXA 1.3.4 + ADS'de TRUE->FALSE yazamiyor, bu yuzden script.\nconst id = $getTagId('SimuHmi', 'tc3_ads');\nconst v = $getTag(id);\nawait $setTag(id, !(v === true || v === 1 || v === '1' || v === 'true'));\n"
    },
    {
      "id": "s_simumachine_toggle",
      "name": "SimuMachineToggle",
      "sync": false,
      "parameters": [],
      "mode": "SERVER",
      "code": "// Boolean tag toggle. Tag'i FUXA'daki ADI ile bul (ADS adresi degil).\n// Not: 'Toggle value' aksiyonu FUXA 1.3.4 + ADS'de TRUE->FALSE yazamiyor, bu yuzden script.\nconst id = $getTagId('SimuMachine', 'tc3_ads');\nconst v = $getTag(id);\nawait $setTag(id, !(v === true || v === 1 || v === '1' || v === 'true'));\n"
    }
