{
  "name": "fuxaw",
  "productName": "fuxaw",
  "version": "0.2.0",
  "description": "FUXA projeleri için masaüstü uygulaması (.fxprj)",
  "main": "src/main/main.js",
  "author": "Samet Cetin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\" \"integrations/native-ads/adsclient/native/test/*.test.js\"",
    "postinstall": "node node_modules/electron/install.js && npm run setup:fuxa",
    "setup:fuxa": "npm install --prefix fuxa-runtime --no-audit --no-fund && npm run setup:ads",
    "fetch:node": "node scripts/fetch-node.js",
    "dist": "npm run fetch:node && npm run setup:ads && electron-builder",
    "dist:dir": "npm run fetch:node && npm run setup:ads && electron-builder --dir",
    "setup:ads": "node integrations/native-ads/apply.js",
    "test:ads": "node --test \"integrations/native-ads/adsclient/native/test/*.test.js\"",
    "probe:ads": "node integrations/native-ads/probe.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.sct.fuxaw",
    "productName": "fuxaw",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "fuxa-runtime/node_modules",
        "to": "fuxa/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "fxprj",
        "name": "FUXA Projesi",
        "description": "fuxaw FUXA projesi",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
