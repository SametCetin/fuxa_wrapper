{
  "name": "fuxaw",
  "productName": "fuxaw",
  "version": "26.1.10024",
  "fullVersion": "26.1.10.24",
  "description": "FUXA projeleri için masaüstü uygulaması (.fxprj)",
  "main": "src/main/main.js",
  "author": "Samet Çetin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\" \"integrations/native-ads/adsclient/native/test/*.test.js\"",
    "postinstall": "node node_modules/electron/install.js && npm run setup:fuxa",
    "setup:fuxa": "npm install --prefix fuxa-runtime --no-audit --no-fund && npm run install:ads",
    "fetch:node": "node scripts/fetch-node.js",
    "dist": "npm run fetch:node && npm run setup:ads && electron-builder",
    "dist:dir": "npm run fetch:node && npm run setup:ads && electron-builder --dir",
    "dist:fast": "npm run fetch:node && npm run setup:ads && electron-builder --win --x64 --dir -c.win.signExecutable=false -c.directories.output=dist/fast",
    "dist:installer": "npm run setup:ads && node scripts/build-installer.js",
    "setup:ads": "node integrations/native-ads/prepare.js",
    "install:ads": "npm install --prefix integrations/native-ads --no-audit --no-fund && npm run setup:ads",
    "test:ads": "node --test \"integrations/native-ads/adsclient/native/test/*.test.js\"",
    "probe:ads": "node integrations/native-ads/probe.js",
    "version:set": "node scripts/set-version.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "buildVersion": "26.1.10.24",
    "appId": "org.sct.fuxaw",
    "productName": "fuxaw",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      { "from": "LICENSE", "to": "LICENSE.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "extraResources": [
      {
        "from": "integrations/native-ads",
        "to": "plugins/native-ads",
        "filter": [
          "**/*",
          "!**/test/**",
          "!probe.js",
          "!prepare.js"
        ]
      },
      {
        "from": "integrations/native-ads/node_modules",
        "to": "plugins/native-ads/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "fuxa-runtime/node_modules",
        "to": "fuxa/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "fxprj",
        "name": "FUXA Projesi",
        "description": "fuxaw FUXA projesi",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SametCetin",
        "repo": "fuxa_wrapper"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/nsis-runtime.nsh",
      "artifactName": "fuxaw-setup-${buildVersion}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
