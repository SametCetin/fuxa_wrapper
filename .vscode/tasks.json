{
  // Ctrl+Shift+B = Release (kurulum paketi, dist/). Debug için Çalıştır ve Hata Ayıkla → "Debug".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hızlı EXE",
      "type": "npm",
      "script": "dist:fast",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Release",
      "type": "npm",
      "script": "dist",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
